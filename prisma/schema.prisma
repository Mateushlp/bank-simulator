// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      Int      @id @default(autoincrement())
  nome    String
  email   String   @unique
  account Account?

  transfersSent     Transfer[] @relation("sentTransfers")
  transfersReceived Transfer[] @relation("receivedTransfers")
  loans             Loan[]
}

model Account {
  id      Int   @id @default(autoincrement())
  balance Float @default(0)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Transfer {
  id    Int      @id @default(autoincrement())
  valor Float
  data  DateTime @default(now())

  senderId   Int
  receiverId Int

  sender   User @relation("sentTransfers", fields: [senderId], references: [id])
  receiver User @relation("receivedTransfers", fields: [receiverId], references: [id])
}

model Loan {
  id             Int      @id @default(autoincrement())
  valor          Float
  data           DateTime @default(now())
  numeroParcelas Int

  userId Int
  user   User @relation(fields: [userId], references: [id])

  installments Installment[]
}

model Installment {
  id       Int    @id @default(autoincrement())
  valor    Float
  numero   Int
  situacao String @default("pendente")

  loanId Int
  loan   Loan @relation(fields: [loanId], references: [id])
}
